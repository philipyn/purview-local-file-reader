<Project Sdk="Azure.Functions.Sdk/1.0.0">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>purviewLocalFileReader.AppOnly.function</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Platform>x64</Platform>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.DurableTask" Version="1.21.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.26.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.87.0" />
    <PackageReference Include="Microsoft.InformationProtection.File" Version="1.18.124" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.app-only.local.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <None Update="host.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="local.settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Update="local.settings.example.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings*.local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="local.settings*.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>